{
    "name": "ksfraser/ksf_payment_destinations",
    "description": "Direct Invoice Payment Destinations for FrontAccounting",
    "type": "library",
    "license": "GPL-2.0",
    "require": {"php": ">=7.3"},
    "require-dev": {
        "phpunit/phpunit": "^7.5 || ^8.5",
        "ksfraser/famock": "*",
        "ksfraser/traits": "*",
        "ksfraser/exceptions": "*",
        "ksfraser/ksf_modules_common": "*"
    },
    "autoload": {"psr-4":{"ksfraser\\PaymentDestinations\\":"src/","ksfraser\\FrontAccounting\\PaymentDestinations\\":"src/"}},
    "autoload-dev": {"psr-4":{"Tests\\":"Tests/"}},
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 php -l",
        "test": [
            "@lint",
            "vendor/bin/phpunit"
        ]
    },
    "minimum-stability":"dev",
    "prefer-stable":true
}
